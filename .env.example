# ---- Somnia Shannon network ----
SOMNIA_RPC_URL=https://dream-rpc.somnia.network
SOMNIA_CHAIN_ID=50312
SOMNIA_EXPLORER_URL=https://shannon-explorer.somnia.network

# ---- Deployment / agent wallets (NEVER commit real values) ----
# The deployer owns the contracts and the AttesterRegistry.
DEPLOYER_PRIVATE_KEY=
# The single authorized attester in v1 (separate wallet recommended).
ATTESTER_PRIVATE_KEY=
# Worker-only key for the pre-funded synthetic breach-test wallet.
DEMO_ATTACKER_PRIVATE_KEY=
# Strong random bearer token for manual/admin settlement endpoints.
PROCESS_TOKEN=

# ---- AI context layer ----
# Server-side only. Never exposed to the frontend. Groq is preferred when both
# providers are configured. If both keys are empty, the system falls back to
# deterministic-only classification.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ---- Frontend (VITE_ vars are inlined at build time) ----
VITE_RPC_URL=https://dream-rpc.somnia.network
VITE_CHAIN_ID=50312
VITE_CHAIN_NAME=Somnia Shannon
VITE_NETWORK_TAG=Somnia Shannon
VITE_EXPLORER_URL=https://shannon-explorer.somnia.network
VITE_ASSET_ADDRESS=
VITE_GATE_ADDRESS=
VITE_ATTESTER_ADDRESS=
# SYNTHETIC demo-attacker key (Hardhat test account #1) used ONLY by the
# concentration-attack simulator to originate a REAL on-chain attack request.
# It controls no real funds and holds only synthetic SLUSD. Auto-emitted by
# scripts/deploy.ts when deploying to a local/Hardhat node.
VITE_DEMO_ATTACKER_ADDRESS=

# ---- Optional: point the agent at a non-mainnet RPC for dev (defaults to localhost:8545) ----
SLUICE_RPC_URL=http://127.0.0.1:8545
# seconds an attestation is valid after signing (agent config, default 600)
ATTESTATION_TTL=600
SLUICE_POLL=1
AGENT_HEALTH_PORT=8787

# Public URL of the hosted agent, used only to display health/decision evidence.
VITE_AGENT_HEALTH_URL=
VITE_AGENT_PROCESS_URL=

# ---- Sluice Markets / DreamDEX Event Contracts (Somnia Shannon) ----
VITE_DREAMDEX_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
VITE_DREAMDEX_RPC_URL=https://dream-rpc.somnia.network
VITE_DREAMDEX_WS_URL=wss://dream-rpc.somnia.network/ws
VITE_DREAMDEX_EXPLORER_URL=https://shannon-explorer.somnia.network
