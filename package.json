{
  "name": "sluice",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Downside-capped Safe Size and IOC execution for DreamDEX Event Contracts on Somnia",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "build": "npm run build:contracts && npm run build:agent",
    "build:contracts": "hardhat compile",
    "build:agent": "tsc -p agent/tsconfig.json",
    "test": "hardhat test",
    "test:agent": "vitest run --config agent/vitest.config.ts",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:somnia": "hardhat run scripts/deploy.ts --network somnia",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "verify:somnia": "hardhat run scripts/verify.ts --network somnia",
    "agent": "node agent/dist/listener.js",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "worker:typecheck": "tsc -p worker/tsconfig.json --noEmit",
    "frontend:typecheck": "tsc -p frontend/tsconfig.json --noEmit",
    "frontend:test": "vitest run --config frontend/vitest.config.ts",
    "verify:secrets": "node scripts/verify-secret-safety.mjs",
    "verify:submission": "npm run verify:secrets && npm run frontend:typecheck && npm run frontend:test && npm run worker:typecheck && npm run test:agent && npm test && npm run frontend:build -- --base=/sluice/",
    "frontend": "vite --config frontend/vite.config.ts",
    "frontend:build": "vite build --config frontend/vite.config.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260821.1",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.7",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.11",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@tanstack/react-query": "^5.59.0",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "chai": "^4.3.10",
    "ethers": "^6.13.1",
    "hardhat": "^2.22.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vitest": "^2.0.5",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.2",
    "@openzeppelin/contracts": "^5.0.2",
    "@somnia-chain/markets-sdk": "^0.28.1",
    "dotenv": "^16.4.5",
    "react-router-dom": "^6.30.4",
    "viem": "^2.21.0",
    "wagmi": "^2.12.0"
  }
}
