{
  "name": "sluice",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "AI-native execution firewall for tokenized assets on BOT Chain",
  "scripts": {
    "build": "npm run build:contracts && npm run build:agent",
    "build:contracts": "hardhat compile",
    "build:agent": "tsc -p agent/tsconfig.json",
    "test": "hardhat test",
    "test:agent": "vitest run --config agent/vitest.config.ts",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:bot": "hardhat run scripts/deploy.ts --network bot",
    "verify:bot": "hardhat run scripts/verify.ts --network bot",
    "agent": "node agent/dist/listener.js",
    "frontend": "vite --config frontend/vite.config.ts",
    "frontend:build": "vite build --config frontend/vite.config.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.7",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.11",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@tanstack/react-query": "^5.59.0",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "chai": "^4.3.10",
    "ethers": "^6.13.1",
    "hardhat": "^2.22.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.2",
    "@openzeppelin/contracts": "^5.0.2",
    "dotenv": "^16.4.5",
    "react-router-dom": "^6.30.4",
    "viem": "^2.21.0",
    "wagmi": "^2.12.0"
  }
}
